DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=replace_locally
DB_NAME=dentino_db
PORT=3001
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Correo saliente (opcional). Si SMTP_HOST y SMTP_FROM están vacíos, el correo queda desactivado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destino de los avisos de nuevas solicitudes si no hay correo en Configuración de la clínica
NOTIFY_EMAIL=

# Carpeta del manifiesto de datos de demostración (seed-demo.ts y complete-demo-history.ts). Por defecto: work/demo
DEMO_OUTPUT_DIR=
